# ============================================================
#  Variables de entorno de RN Inmobiliaria
#  Copiá este archivo a .env.local y completá los valores.
# ============================================================

# --- Supabase (obligatorias) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# --- Sitio ---
# URL pública final (para metadata / OpenGraph / sitemap).
NEXT_PUBLIC_SITE_URL=https://rn-inmobiliaria.vercel.app

# --- Contacto (opcionales, si no se define se usa el valor por defecto) ---
NEXT_PUBLIC_WHATSAPP=5493765067519
NEXT_PUBLIC_WHATSAPP_SOCIO=

# --- Redes (opcionales) ---
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_FACEBOOK=

# --- Asistente de carga por IA (obligatoria para /admin → pestaña "Asistente IA") ---
# Clave gratuita de la API de Gemini (Google AI Studio, no pide tarjeta):
# https://aistudio.google.com/apikey — se usa solo del lado del servidor
# (app/api/asistente), nunca se expone al navegador.
GEMINI_API_KEY=
